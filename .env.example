# Bind address. Empty (the default) binds all interfaces, which the container needs. Keep 127.0.0.1
# for local dev: anything on 0.0.0.0 on a machine with a public IP is reachable from the internet.
HOST=127.0.0.1
# 8000 is growth-portal's and 8001 luma-service's locally. The container listens on 8000.
PORT=8002

# Postgres; `docker compose up -d` starts this one.
DATABASE_URL=postgres://crm:crm@127.0.0.1:5436/crm?sslmode=disable

# Sign-in stand-in until identity-service is live (docs/pcr/0005): every request is signed in as this
# user. Unset, the API refuses every request but health. Never set in production.
DEV_USER_EMAIL=dev@kthais.com

# Comma-separated emails that become admins when they sign in (docs/adr/0003). Admins manage the team and
# roles in the app; this only promotes, it never demotes.
ADMIN_EMAILS=dev@kthais.com
