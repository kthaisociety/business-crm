# Bind address. Empty (the default) binds all interfaces, which the container needs. Keep 127.0.0.1
# for local dev: anything on 0.0.0.0 on a machine with a public IP is reachable from the internet.
HOST=127.0.0.1
# 8000 is growth-portal's and 8001 luma-service's locally. The container listens on 8000.
PORT=8002

# Postgres; `docker compose up -d` starts this one.
DATABASE_URL=postgres://crm:crm@127.0.0.1:5436/crm?sslmode=disable

# Local work without an OIDC client (docs/pcr/0007): every request is signed in as this user. Never set in
# a deployed environment; the server refuses to start with both this and an OIDC client set.
DEV_USER_EMAIL=dev@kthais.com

# Real sign-in (docs/adr/0004). To try it locally: unset DEV_USER_EMAIL, fill in the client, and add
# PUBLIC_URL/auth/callback to the client's authorized redirect URIs. PUBLIC_URL is where you open the app:
# http://127.0.0.1:5174 with `npm run dev`, http://127.0.0.1:8002 with the built frontend.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# PUBLIC_URL=http://127.0.0.1:5174
# SIGN_IN_DOMAIN=kthais.com

# The team's Fathom webhook (docs/adr/0006): meetings it posts to /api/integrations/fathom become
# touchpoints. The secret Fathom shows for the webhook, whsec_... Unset, the route is off.
# FATHOM_WEBHOOK_SECRET=

# Connect Gmail (docs/adr/0006): seals members' Gmail refresh tokens. 32 random bytes in base64:
# `openssl rand -base64 32`. Setting it turns Connect Gmail on, which needs real sign-in above; add
# PUBLIC_URL/auth/gmail/callback to the Google client's redirect URIs. GMAIL_CLIENT_ID and _SECRET are
# only needed once sign-in isn't Google's own client.
# TOKEN_ENCRYPTION_KEY=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
